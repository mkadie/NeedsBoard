# ===================================================
#  Base Menu — FruitJam (3x2 grid, 160x128)
#
#  Artwork is the Moana icon set; the two cells with no Moana equivalent
#  (WC, Food/Drink) are generated type tiles in the same palette. Regenerate
#  the whole set with:  python3 make_base_icons.py
#
#  Layout (3 columns × 2 rows):
#
#  +----------+----------+----------+
#  |   Yes    |    No    | Please & |
#  |          |          |Thank You |
#  |    1     |    2     |    3     |
#  +----------+----------+----------+
#  | Bathroom |   Play   |Food/Drink|
#  |    4     |    5     |    6     |
#  +----------+----------+----------+
# ===================================================

[menu]
name = Base Menu
text_description = Basic needs
type = grid
columns = 3
rows = 2
background = images/base/base_board.bmp

# ----- Top Row -----

[yes]
label = Yes
text_description = Yes
image = images/base/yes.bmp
sound = /button_sounds/yes.mp3
position = 1

[no]
label = No
text_description = No
image = images/base/no.bmp
sound = /button_sounds/no.mp3
position = 2

[thankyou]
label = Please and Thank You
text_description = Please and thank you
image = images/base/thankyou.bmp
sound = /button_sounds/please_and_thank_you.mp3
position = 3

# ----- Bottom Row -----

[bathroom]
label = Bathroom
text_description = I need the bathroom
image = images/base/bathroom.bmp
sound = /button_sounds/bathroom.mp3
position = 4

[play]
label = Play
text_description = I want to play
image = images/base/play.bmp
sound = /button_sounds/play.mp3
position = 5

[fooddrink]
label = Food/Drink
text_description = Food and drink
image = images/base/fooddrink.bmp
submenu = food_fruitjam.menu
position = 6
