# ===================================================
#  Base Menu — FruitJam V2 (3x2 grid)
#
#  Layout (3 columns × 2 rows):
#
#  +----------+----------+----------+
#  | Thank You|  Stinky  |   More   |
#  |    1     |    2     |    3     |
#  +----------+----------+----------+
#  | Bathroom |   Yes    |    No    |
#  |    4     |    5     |    6     |
#  +----------+----------+----------+
# ===================================================

[menu]
name = Base Menu
type = grid
columns = 3
rows = 2
background = images/base/base_board.bmp

# ----- Top Row -----

[thankyou]
label = Thank You
image = images/base/please.bmp
sound = /button_sounds/please.mp3
position = 1

[stinky]
label = Stinky
image = images/base/stinky.bmp
sound = /button_sounds/f_you.mp3
position = 2

[more]
label = More
image = images/base/more.bmp
submenu = food_fruitjam.menu
position = 3

# ----- Bottom Row -----

[bathroom]
label = Bathroom
image = images/base/bathroom.bmp
sound = /button_sounds/bathroom.mp3
position = 4

[yes]
label = Yes
image = images/base/yes.bmp
sound = /button_sounds/yes.mp3
position = 5

[no]
label = No
image = images/base/no.bmp
sound = /button_sounds/no.mp3
position = 6
